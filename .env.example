# --- Magento (obligatorio) ---
# URL base de la tienda, sin barra final
MAGENTO_BASE_URL=https://mitienda.com
# Token de la integración (System > Extensions > Integrations). No hace falta con AUTH_MODE=magento
MAGENTO_TOKEN=
# Código de store para la API. "all" = valores globales (recomendado)
MAGENTO_STORE_CODE=all
# Opcional: URL base para las imágenes si usas CDN (por defecto MAGENTO_BASE_URL/media/catalog/product)
MAGENTO_MEDIA_URL=

# --- Acceso al dashboard: elige UNA opción ---
# Opción M (recomendada): cada persona entra con su usuario del Admin de Magento.
# Cada uno trabaja con su propio token y sus permisos; MAGENTO_TOKEN no se usa.
AUTH_MODE=
# Horas que dura la sesión. Igual que "Admin Token Lifetime" de Magento (4 por defecto).
MAGENTO_ADMIN_TOKEN_HOURS=4
# "off" si tu Magento NO tiene 2FA en el Admin (por defecto se pide el código de Google Authenticator).
MAGENTO_ADMIN_2FA=

# Opción A: contraseña simple
DASHBOARD_PASSWORD=
# Clave para firmar/cifrar la cookie de sesión (texto aleatorio de 16+ caracteres). Obligatoria con AUTH_MODE=magento
SESSION_SECRET=

# Opción B: Supabase Auth (si están definidas, se usan en lugar de la contraseña)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
